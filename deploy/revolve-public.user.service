# User-level systemd unit for Revolve behind a reverse proxy (LAN mode).
# Private-network peers only; every request needs the access key, which the
# proxy adds as X-Revolve-Key after its own authentication. Install with:
#   mkdir -p ~/.config/systemd/user && cp deploy/revolve-public.user.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now revolve-public
# Needs config/planner.json and the API key (environment or a chmod-600 .env)
# in WorkingDirectory for the AI to write programs. `loginctl enable-linger`
# keeps it running without a login session.
[Unit]
Description=Revolve (behind the revolve.samix-technology.com proxy)
After=network-online.target

[Service]
WorkingDirectory=%h/revolve/src
ExecStart=%h/revolve/target/release/revolve --state-dir %h/revolve/state/public --scenarios-dir %h/revolve/src/scenarios serve --lan --bind 0.0.0.0:8080 --step-delay-ms 0 --public-host revolve.samix-technology.com
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
